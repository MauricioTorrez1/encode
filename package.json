{
  "name": "encode",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Entrena tu mente de programador, un commit al día.",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs",
    "dev": "vite",
